# Copia este archivo como .env.local (desarrollo) y carga los mismos nombres en Vercel.
# Nunca subas valores reales al repositorio.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# PIN compartido de los guardias (solo servidor)
GUARD_PIN=
# Secreto para firmar cookies, 32 caracteres aleatorios o más (solo servidor)
SESSION_SECRET=

# Cuenta Gmail dedicada del evento y su contraseña de aplicación (solo servidor)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# URL pública del sitio, por ejemplo https://ukhu-pacha-pass.vercel.app
APP_URL=

TICKET_PRICE=20
EVENT_CAPACITY=250
